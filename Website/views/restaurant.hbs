        <script src="../Controllers/RestoInfo.js"></script>
        <script>
            // Store restaurant ID for use in like/unlike functions
            const restaurantId = "{{restaurant.id}}";
            
            function toggleHeart() {
                const heartIcon = document.getElementById("heartIcon");
                const isLiking = !heartIcon.classList.contains("liked");
                
                // Get current user data
                const userData = localStorage.getItem('currentUser');
                if (!userData) {
                    alert('Please login to save restaurants');
                    return;
                }
                
                try {
                    const user = JSON.parse(userData);
                    if (!user || !user.userId) {
                        alert('Please login to save restaurants');
                        return;
                    }
                    
                    const userId = user.userId;
                    const endpoint = isLiking ? '/api/restaurants/like' : '/api/restaurants/unlike';
                    
                    // Send API request to like/unlike restaurant
                    fetch(endpoint, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            userId: userId,
                            restoId: restaurantId
                        })
                    })
                    .then(response => {
                        if (!response.ok) {
                            return response.json().then(err => {
                                throw new Error(err.message || 'Server error');
                            });
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            // Toggle heart appearance
                            heartIcon.classList.toggle("liked");
                            heartIcon.style.color = isLiking ? "red" : "gray";
                            console.log(isLiking ? 'Restaurant saved' : 'Restaurant unsaved');
                        } else {
                            console.error('Failed to update saved status:', data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error updating restaurant saved status:', error);
                        alert('Failed to update restaurant saved status: ' + error.message);
                    });
                } catch (e) {
                    console.error('Error parsing user data:', e);
                    alert('Please login to save restaurants');
                }
            }
    
            // Add explicit implementation of toggleReviewModal function
            function toggleReviewModal() {
                const backdrop = document.getElementById('backdrop');
                const reviewModal = document.getElementById('reviewModal');
                
                if (reviewModal && backdrop) {
                    if (reviewModal.style.display === 'block') {
                        reviewModal.style.display = 'none';
                        backdrop.style.display = 'none';
                    } else {
                        reviewModal.style.display = 'block';
                        backdrop.style.display = 'block';
                    }
                } else {
                    console.error('Modal elements not found');
                }
            }
        </script>
        <script src='../Controllers/directoryScript.js' type="module"></script>
        <script src='../Controllers/Restaurants/updateResto.js'></script>
        <script src='../Controllers/Restaurants/deleteResto.js'></script>
        <script src='../Controllers/Reviews/addReview.js'></script>
        <script src='../Controllers/Reviews/editReview.js'></script>
        <script src='../Controllers/Reviews/deleteReview.js'></script>
        <script src='../Controllers/Reviews/replyReview.js'></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                // Fix profile links in reviews
                const profileLinks = document.querySelectorAll('.scroll-obj h2 a');
                profileLinks.forEach(link => {
                    link.addEventListener('click', function(e) {
                        const href = this.getAttribute('href');
                        // Check if the link ends with just "/profile/" or contains "undefined"
                        if (href === '/profile/' || href.includes('undefined')) {
                            e.preventDefault();
                            alert('User profile not available');
                        }
                    });
                });
                
                // Fix profile images
                const profileImages = document.querySelectorAll('.profile-pic');
                profileImages.forEach(img => {
                    img.onerror = function() {
                        this.src = '../views/images/profilePictures/default-profile.png';
                    };
                });

                // Enhance togglePopupCreateResto to call populateEditForm
                const originalTogglePopup = window.togglePopupCreateResto;
                window.togglePopupCreateResto = function() {
                    if (typeof originalTogglePopup === 'function') {
                       originalTogglePopup();
                    }
                    // Call populateEditForm after popup is opened
                    if (document.getElementById('createRestoFrame').style.display === 'block') {
                        console.log("Calling populateEditForm after popup opened");
                        populateEditForm();
                    }
                };
                
                // Check if the restaurant is already liked
                checkIfRestaurantIsLiked();
            });
            
            // Check if current restaurant is already in user's saved list
            function checkIfRestaurantIsLiked() {
                const userData = localStorage.getItem('currentUser');
                if (!userData) {
                    return;
                }
                
                try {
                    const user = JSON.parse(userData);
                    if (!user || !user.userId) {
                        return;
                    }
                    
                    const userId = user.userId;
                    const restoId = "{{restaurant.id}}";
                    
                    // Fetch user's saved restaurants
                    fetch(`/api/likes/saved-restaurants/${userId}`)
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Failed to fetch saved restaurants');
                            }
                            return response.json();
                        })
                        .then(restaurants => {
                            // Check if current restaurant is in the list
                            const isLiked = restaurants.some(resto => resto.resto_id == restoId);
                            
                            // Update heart icon if restaurant is liked
                            if (isLiked) {
                                const heartIcon = document.getElementById("heartIcon");
                                heartIcon.classList.add("liked");
                                heartIcon.style.color = "red";
                            }
                        })
                        .catch(error => {
                            console.error('Error checking if restaurant is liked:', error);
                        });
                } catch (e) {
                    console.error('Error parsing user data:', e);
                }
            }
        </script>

        <script src="../Controllers/utils/authManager.js" type="module"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
            // Check if user is logged in and update UI
            const currentUserString = localStorage.getItem('currentUser');
            if (currentUserString) {
                try {
                    const currentUser = JSON.parse(currentUserString);
