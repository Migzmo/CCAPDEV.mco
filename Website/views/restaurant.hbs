            import { toggleEditProfileFrame, setupProfilePicPreview, setupProfileUpdateHandler } from '../Controllers/Accounts/updateAccount.js';
            import { setupDeleteAccountHandlers } from '../Controllers/Accounts/deleteAccount.js';
            
            // Make functions available globally
            window.toggleEditProfileFrame = toggleEditProfileFrame;
            
            document.addEventListener('DOMContentLoaded', function() {
                setupProfilePicPreview();
                setupProfileUpdateHandler();
                setupDeleteAccountHandlers();
            });
        </script>
    </body>

