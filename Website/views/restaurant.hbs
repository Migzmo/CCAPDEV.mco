        <script>
            // Toggle login popup function
            function togglePopup() {
                const loginFrame = document.getElementById('loginframe');
                const backdrop = document.getElementById('backdrop');
                
                if (loginFrame && backdrop) {
                    if (loginFrame.style.display === 'block') {
                        loginFrame.style.display = 'none';
                        backdrop.style.display = 'none';
                        document.body.style.pointerEvents = 'auto';
                    } else {
                        loginFrame.style.display = 'block';
                        backdrop.style.display = 'block';
                        document.body.style.pointerEvents = 'none';
                        loginFrame.style.pointerEvents = 'auto';
                        backdrop.style.pointerEvents = 'auto';
                    }
                }
            }

            // Add event listeners for login functionality
            document.addEventListener('DOMContentLoaded', function() {
                // Register button in login frame
                const registerBtn = document.getElementById('register');
                if (registerBtn) {
                    registerBtn.addEventListener('click', function() {
                        document.getElementById('loginframe').style.display = 'none';
                        document.getElementById('registerframe').style.display = 'block';
                        document.body.style.pointerEvents = 'none';
                        document.getElementById('registerframe').style.pointerEvents = 'auto';
                        document.getElementById('backdrop').style.pointerEvents = 'auto';
                    });
                }
                
                // Back to login button
                const backToLoginBtn = document.getElementById('backToLogin');
                if (backToLoginBtn) {
                    backToLoginBtn.addEventListener('click', function() {
                        document.getElementById('registerframe').style.display = 'none';
                        document.getElementById('loginframe').style.display = 'block';
                    });
                }
                
                // Signin button
                const signinBtn = document.querySelector('.signin-button');
                if (signinBtn) {
                    signinBtn.addEventListener('click', function() {
                        document.getElementById('loginframe').style.display = 'none';
                        document.getElementById('signinframe').style.display = 'block';
                        document.body.style.pointerEvents = 'none';
                        document.getElementById('signinframe').style.pointerEvents = 'auto';
                        document.getElementById('backdrop').style.pointerEvents = 'auto';
                    });
                }
                
                // Back to options button
                const backToOptionsBtn = document.getElementById('backToOptions');
                if (backToOptionsBtn) {
                    backToOptionsBtn.addEventListener('click', function() {
                        document.getElementById('signinframe').style.display = 'none';
                        document.getElementById('loginframe').style.display = 'block';
                    });
                }
                
                // Close signin button
                const closeSigninBtn = document.getElementById('closeSignin');
                if (closeSigninBtn) {
                    closeSigninBtn.addEventListener('click', function() {
                        document.getElementById('signinframe').style.display = 'none';
                        document.getElementById('backdrop').style.display = 'none';
                        document.body.style.pointerEvents = 'auto';
                    });
                }

                // Close register button
                const closeRegisterBtn = document.getElementById('closeRegister');
                if (closeRegisterBtn) {
                    closeRegisterBtn.addEventListener('click', function() {
                        document.getElementById('registerframe').style.display = 'none';
                        document.getElementById('backdrop').style.display = 'none';
                        document.body.style.pointerEvents = 'auto';
                    });
                }
            });
        </script>

        <script type="module">
        document.addEventListener('DOMContentLoaded', function() {
            // Import profile update functionality
            import('../Controllers/Accounts/updateAccount.js')
                .then(module => {
                    // Make these functions available globally if they aren't already
                    window.setupProfilePicPreview = module.setupProfilePicPreview;
                    window.setupProfileUpdateHandler = module.setupProfileUpdateHandler;
                    
                    // Initialize profile pic preview functionality
                    setupProfilePicPreview();
                    
                    // Initialize profile update handler
                    setupProfileUpdateHandler();
                    
                    // Setup delete account confirmation
                    const deleteAccountBtn = document.getElementById('delete-account-btn');
                    const deleteConfirm = document.getElementById('deleteAccountConfirm');
                    const cancelDelete = document.getElementById('cancelDeleteAccount');
                    const confirmDelete = document.getElementById('confirmDeleteAccount');
                    
                    if (deleteAccountBtn) {
                        deleteAccountBtn.addEventListener('click', function() {
                            deleteConfirm.style.display = 'block';
                            document.getElementById('backdrop').style.display = 'block';
                        });
                    }
                    
                    if (cancelDelete) {
                        cancelDelete.addEventListener('click', function() {
                            deleteConfirm.style.display = 'none';
                            document.getElementById('backdrop').style.display = 'none';
                        });
                    }
                    
                    if (confirmDelete) {
                        confirmDelete.addEventListener('click', function() {
                            const currentUser = JSON.parse(localStorage.getItem('currentUser'));
                            if (currentUser && currentUser.userId) {
                                fetch('/api/users/delete-account', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify({ userId: currentUser.userId })
                                })
                                .then(response => response.json())
                                .then(data => {
                                    if (data.success) {
                                        alert('Account deleted successfully');
                                        localStorage.removeItem('currentUser');
                                        window.location.href = '/';
                                    } else {
                                        alert('Failed to delete account: ' + data.message);
                                    }
                                })
                                .catch(error => {
                                    console.error('Error deleting account:', error);
                                    alert('An error occurred while deleting account');
                                });
                            }
                        });
                    }
                })
                .catch(err => console.error('Error importing profile update module:', err));
        });
    </script>

