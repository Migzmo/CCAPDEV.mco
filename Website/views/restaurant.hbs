<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>LaSapp</title>
        <link rel="icon" href="views/images/assets/logo.png" type="image/png">
        <link rel="stylesheet" href="../Views/restohbsstyle.css"/>
        <link href="https://fonts.googleapis.com/css2?family=Baloo&display=swap" rel="stylesheet">
        <img src="../Views/images/assets/logo.png" id="logoImg" alt="logo" height="70" width="70">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&family=Noto+Color+Emoji&family=Noto+Emoji:wght@300..700&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=search" />

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&family=Lexend:wght@100..900&family=Noto+Color+Emoji&family=Noto+Emoji:wght@300..700&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    
        <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js"></script>
    </head>
    <body>
        <!-- Navigation Bar -->
        <header class="navbar">
            <!-- First Header -->
            <div class="navbar-container">
                <a href="/" id="logoImg">
                <img src="../Views/images/assets/logo.png" alt="Logo" width="70" height="70">
                </a>
                <div class="logo">LaSapp</div>
                
                <div class="options">
                    <ul>
                        <li><a href="/">DIRECTORY</a></li>
                        {{#if currentUser}}
                        <li>
                            <div class="user-dropdown">
                                <button class="dropdown-toggle" id="userDropdownToggle">
                                    <img src="{{currentUser.profilePic}}" alt="Profile" class="profile-pic-small" onerror="this.src='/Views/images/profilePictures/default-profile.png'">
                                    {{currentUser.username}}
                                </button>
                                <div class="dropdown-menu" id="userDropdownMenu">
                                    <a href="#" id="viewProfileBtn">My Profile</a>
                                    <a href="#" id="logoutBtn">Logout</a>
                                </div>
                            </div>
                        </li>
                        {{else}}
                        <li><button id="loginButton" class="login-button">LOGIN</button></li>
                        {{/if}}
                    </ul>
                </div>
            </div>
        </header>
        <div id="backdrop"></div>
        
        {{#unless currentUser}}
        <!-- Login Frame -->
        <div id="loginframe">
            <div class="loginframe-content">
                <div id="loginframe_left">
                    <h2>Log in or sign up now!</h2>
                    <div class="button-container">
                        <button class="signin-button"><span id="mail-logo"></span>Continue with Account</button>
                        <button class="login-button"><span id="google-logo"></span>Login with Gmail</button>
                    </div>
                    <p class="describe-register">New to LaSapp?<button id="register">Create account</button></p>
                    <p class="Description">By using LaSapp, you agree to follow the guidelines outlined in the <a href="">DLSU Student Handbook</a> and/or <a href="">Privacy Policy</a> of LaSapp.</p>
                </div>
                <div id="loginframe_right">
                    <button id="closeLogin">&times</button>
                </div>
            </div>
        </div>

        <div id="signinframe">
            <div class="signinframe-content">
                <div id="signinframe_left">
                    <h2 id="h2-signin">Sign in</h2>
                    <form class="signin-form">
                        <div class="form-group">
                            <input type="text" id="signin-username" placeholder="Username" required>
                        </div>
                        <div class="form-group">
                            <input type="password" id="signin-password" placeholder="Password" required>
                        </div>

                        <div class="remember-me">
                            <input type="checkbox" id="remember" name="remember">
                            <label for="remember">Remember me</label>
                        </div>
                        <button type="submit" class="signin-submit-button">Sign in</button>
                        <p class="back-to-login">Need an account? <button type="button" id="backToOptions">Go back</button></p>
                    </form>
                </div>
                <div id="signinframe_right">
                    <button id="closeSignin">&times;</button>
                </div>
            </div>
        </div>
        {{/unless}}
        
        <div id="createRestoFrame">
            <div class="createResto-header">
                <h2>Edit Restaurant</h2>
            </div>
            <div class="createResto-content">
                <div class="wrapper">
                    <form name="restoForm" action="/api/submitupdate" method="post" enctype="multipart/form-data">
                        <!-- Basic Information -->
                        <input type="hidden" id="hidden-id" name="resto_id" value="{{restaurant.id}}">
                        <div class="form-section">
                            <h4>Basic Information</h4>
                            <div class="input-box">
                                <label for="resto-name">Restaurant Name</label>
                                <input type="text" id="resto-name" placeholder="Enter restaurant name" required>
                            </div>
                        </div>
                        
                        <!-- Address Section -->
                        <div class="form-section">
                            <h4>Location</h4>
                            <div class="input-box">
                                <label for="address1">Address Line 1</label>
                                <input type="text" id="address1" placeholder="Street address" required>
                            </div>
                            <div class="input-box">
                                <label for="address2">Address Line 2</label>
                                <input type="text" id="address2" placeholder="Building, floor, etc. (optional)">
                            </div>
                        </div>
                        
                        <!-- Operating Hours -->
                        <div class="form-section">
                            <h4>Operating Hours</h4>
                            <div class="input-box time-input">
                                <label for="opening-time">Opening Time</label>
                                <input type="time" id="opening-time" required>
                            </div>
                            <div class="input-box time-input">
                                <label for="closing-time">Closing Time</label>
                                <input type="time" id="closing-time" required>
                            </div>
                        </div>
                        
                        <!-- Contact Information -->
                        <div class="form-section">
                            <h4>Contact Information</h4>
                            <div class="input-box">
                                <label for="phone">Phone Number</label>
                                <input type="tel" id="phone" placeholder="Phone number" required>
                            </div>
                            <div class="input-box">
                                <label for="email">Email</label>
                                <input type="email" id="email" placeholder="Email address" required>
                            </div>
                        </div>
                        
                        <!-- Additional Information -->
                        <div class="form-section">
                            <h4>Additional Information</h4>
                            <div class="input-box">
                                <label for="payment">Payment Methods</label>
                                <input type="text" id="payment" placeholder="Cash, Credit Card, GCash, etc." required>
                            </div>
                            <div class="input-box">
                                <label for="perks">Perks</label>
                                <input type="text" id="perks" placeholder="Wi-Fi, Parking, etc." required>
                            </div>
                            <div class="input-box">
                                <label for="cuisine">Cuisine</label>
                                <select id="cuisine" name="cuisine" required>
                                    <option value="">Select a cuisine type</option>
                                    <option value="American">American</option>
                                    <option value="Asian">Asian</option>
                                    <option value="Cafe">Cafe</option>
                                    <option value="Chinese">Chinese</option>
                                    <option value="Fastfood">Fastfood</option>
                                    <option value="Filipino">Filipino</option>
                                    <option value="Japanese">Japanese</option>
                                    <option value="Korean">Korean</option>
                                    <option value="Mexican">Mexican</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="form-section">
                            <h4>Reference Image</h4>
                            <div class="input-box image-upload">
                                <label for="restaurant-images">Upload Reference Photo</label>
                                <input type="file" id="restaurant-images" name="image" accept="image/*">
                            </div>
                        </div>

                        <!-- Button Section stays inside the scrollable area but will be styled to stand out -->
                        <div class="button-section">
                            <div class="input-box button">
                                <input type="submit" id="updateSub" value="Update Restaurant">
                            </div>
                            <div class="input-box button secondary">
                                <input type="button" value="Cancel" id="cancelCreateResto">
                            </div>
                        </div>
                    </form>
                </div>
                <button id="closeCreateResto">&times</button>
            </div>
        </div>

        <div id="deleteConfirmPopup">
            <div class="deleteConfirm-content">
                <div class="deleteConfirm-header">
                    <h2>Confirm Deletion</h2>
                </div>
                <div class="deleteConfirm-body">
                    <p>Are you sure you want to delete this restaurant?</p>
                    <p class="warning-text">This action cannot be undone.</p>
                    
                    <div class="confirm-buttons">
                        <button class="cancel-delete-btn" id="cancelDeleteResto">Cancel</button>
                        <button class="confirm-delete-btn" id="confirmDeleteResto">Yes, Delete</button>
                    </div>
                </div>
                <button id="closeDeleteConfirm">&times;</button>
            </div>
        </div>

        <div id="deleteReviewConfirmPopup">
            <div class="deleteConfirm-header">
                <h2>Delete Review</h2>
                <button id="closeDeleteReviewConfirm">&times;</button>
            </div>
            <div class="deleteConfirm-body">
                <p>Are you sure you want to delete this review?</p>
                <p class="warning-text">This action cannot be undone.</p>
                <div class="confirm-buttons">
                    <button class="cancel-delete-btn" id="cancelDeleteReview">Cancel</button>
                    <button class="confirm-delete-btn" id="confirmDeleteReview">Delete</button>
                </div>
            </div>
        </div>

        <!-- Restaurant Information -->
        <div class="info">
            <!-- Exit Button -->
            <div class="buttons-container">
                {{#if (eq restaurant.userType "business-owner")}}
                <button class="oval-button-review delete-btn" id="deleteRestoBtn">Delete</button>
                <button class="oval-button-review edit-btn" id="editRestoBtn">Edit</button>
                {{/if}}
                <a href="/">
                    <button class="oval-button-review">Back</button>
                </a>
            </div>
            <!-- Header -->
            <div class="classheader">
                <button id="heartBtn" class="btn">
                    <i id="heartIcon" class="fa-solid fa-heart heart" data-resto-id="{{restaurant.id}}"></i>
                </button>
                <div class="head-container">
                    <h1>{{restaurant.name}}</h1>  
                    <p>{{restaurant.cuisine}}</p> 
                </div>
            </div>          
            <!-- Main body-->
            <div class="main">
                <img src={{restaurant.image}} alt={{restaurant.name}}>
                <div class="information">
                    <h1>About:</h1>
                    <h2>📍 Address: </h2>
                    <p>{{restaurant.address}}</p>
                    <h2>⏰ Time: </h2>
                    <p>
                    {{#if restaurant.opening_time}}
                    {{formatTime restaurant.opening_time}} - {{formatTime restaurant.closing_time}}
                    {{else}}
                    {{restaurant.time}}
                    {{/if}}
                    </p>
                    <h2>📱 Phone #: </h2>
                    <p>{{restaurant.phone}}</p>
                    <h2>📥 Email: </h2>
                    <p>{{restaurant.email}}</p>
                    <h2>💸 Payment Method: </h2>
                    <p>Cash, GCash, Debit Card</p>
                    <br>

                    <h1>Perks:</h1>
                    <ul>
                        {{#each restaurant.perks}}
                        <li>{{this}}</li>
                        {{/each}}
                    </ul>
                
                </div>
            </div>

            <!-- Reviews -->
            <div class="reviews">
                <div class="review1">
                    <h1>Reviews</h1>
                    <button class="button-3" id="makeReviewBtn">Make a Review</button>
                </div>
                
                <div id="reviewModal">
                    <div class="reviewModal-header">
                        <h2>Write a Review</h2>
                    </div>
                    <div class="reviewModal-content">
                        <div class="wrapper">
                            <form action="/api/addreview" name="create-review" method="post">
                                <!-- Restaurant Name -->
                                <div class="form-section">
                                    <h4>{{restaurant.name}}</h4>
                                    
                                    <!-- Rating Section -->
                                    <div class="rating-container">
                                        <label>Your Rating:</label>
                                        <div class="star-rating">
                                            <span class="star" data-value="1">★</span>
                                            <span class="star" data-value="2">★</span>
                                            <span class="star" data-value="3">★</span>
                                            <span class="star" data-value="4">★</span>
                                            <span class="star" data-value="5">★</span>
                                        </div>
                                        <span id="rating-text">0 out of 5</span>
                                    </div>
                                </div>
                                
                                <!-- Review Content -->
                                <div class="form-section">
                                    <div class="input-box">
                                        <label for="review-content">Your Review</label>
                                        <textarea id="review-content" placeholder="Share your experience with this restaurant..." required></textarea>
                                    </div>
                                </div>

                                <!-- Button Section -->
                                <div class="button-section">
                                    <div class="input-box button">
                                        <input type="submit" id="submitReview" value="Submit Review">
                                    </div>
                                    <div class="input-box button secondary">
                                        <input type="button" value="Cancel" id="cancelReview">
                                    </div>
                                </div>
                            </form>
                        </div>
                        <button id="closeReviewModal">&times;</button>
                    </div>
                </div>

                <div id="editReviewModal">
                    <div class="reviewModal-header">
                        <h2>Edit Review</h2>
                    </div>
                    <div class="reviewModal-content">
                        <div class="wrapper">
                            <form action="/api/editreview" name="edit-review" method="post" enctype="multipart/form-data">
                                <!-- Restaurant Name -->
                                <div class="form-section">
                                    <h4>{{restaurant.name}}</h4>
                                    
                                    <!-- Rating Section -->
                                    <div class="rating-container">
                                        <label>Your Rating:</label>
                                        <div class="star-rating" id="edit-star-rating">
                                            <span class="star" data-value="1">★</span>
                                            <span class="star" data-value="2">★</span>
                                            <span class="star" data-value="3">★</span>
                                            <span class="star" data-value="4">★</span>
                                            <span class="star" data-value="5">★</span>
                                        </div>
                                        <span id="edit-rating-text">0 out of 5</span>
                                    </div>
                                </div>
                                
                                <!-- Review Content -->
                                <div class="form-section">
                                    <div class="input-box">
                                        <label for="edit-review-content">Your Review</label>
                                        <textarea id="edit-review-content" name="review" placeholder="Share your experience with this restaurant..." required></textarea>
                                    </div>
                                </div>

                                <!-- Hidden input for review ID -->
                                <input type="hidden" id="edit-review-id" name="review_id" value="">
                        
                                <!-- Button Section -->
                                <div class="button-section">
                                    <div class="input-box button">
                                        <input type="submit" id="submitEditReview" value="Update Review">
                                    </div>
                                    <div class="input-box button secondary">
                                        <input type="button" value="Cancel" id="cancelEditReview">
                                    </div>
                                </div>
                            </form>
                        </div>
                        <button id="closeEditReviewModal">&times;</button>
                    </div>
                </div>
                          
                <!-- Scrollable Reviews -->
                <div>
                    <div class="scroll-div"> 
                        <!-- Feed Reviews -->
                        {{#each reviews}}

                        <!-- Will only display the reviews if isAlive = true -->
                        <div class="scroll-obj">   
                            <h2>
                                {{#if this.account_id}}
                                    <a href="/profile/{{this.account_id.acc_id}}">
                                        <img src="{{this.account_id.profile_pic}}" alt="Profile" class="profile-pic" onerror="this.src='/Views/images/profilePictures/default-profile.png'"> 
                                        {{this.account_id.acc_name}}
                                    </a>
                                {{else}}
                                    <span>
                                        <img src="../Views/images/profilePictures/default-profile.png" alt="Profile" class="profile-pic"> 
                                        Anonymous
                                    </span>
                                {{/if}}

                                <button class="delete-review" data-id="{{this.review_id}}">🗑️</button>
                            </h2>
                            
                            <!-- Add star rating visualization (display actual rating when available) -->
                            <div class="review-rating">
                            {{#if this.rating}}
                                {{!-- Display all stars on one line to remove space --}}
                                {{#for 0 this.rating}}★{{/for}}{{#for this.rating 5}}☆{{/for}}
                            {{else}}
                                No rating
                            {{/if}}
                            </div>
                            
                            <p>{{this.review}}</p>
                            
                            <!-- Add timestamp (use actual timestamp when available) -->
                            <span class="review-date">
                            {{#if this.isEdited}}
                                Last Edited: {{this.editedDate}}
                            {{else}}
                                Posted on {{this.date}}
                            {{/if}}
                            </span>
                            
                            <!-- ADD FORMS FOR THIS -->
                            <div class="input-box button">
                                <input type="hidden" id="hidden-review-id" name="review_id" value="{{this.review_id}}">
                                <button type="button" class="oval-button-review edit-review-btn" data-id="{{this.review_id}}">Edit</button>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer>
            <img src="../Views/images/assets/logo.png" id="footerLogo" alt="logo" height="70" width="70">
            <div class="logo">LaSapp</div>

            <div class="footerIcon">
                <a href="https://www.facebook.com" target="_blank">
                    <img src="../Views/images/assets/facebook.png" id="footerFacebook" alt="Facebook" width="30" height="30">
                </a>
                <a href="https://www.instagram.com" target="_blank">
                    <img src="../Views/images/assets/instagram.png" id="footerIG" alt="Instagram" width="30" height="30">
                </a>
            </div>
        </footer>

        <script src="../Controllers/RestoInfo.js"></script>
        <script>
            // Store restaurant ID for use in like/unlike functions
            const restaurantId = "{{restaurant.id}}";
            
            document.addEventListener('DOMContentLoaded', function() {
                console.log("DOM loaded, setting up functionality");
                
                // Setup login button when not logged in
                const loginButton = document.getElementById('loginButton');
                if (loginButton) {
                    console.log("Found login button, attaching click handler");
                    loginButton.addEventListener('click', function() {
                        console.log("Login button clicked");
                        const loginframe = document.getElementById('loginframe');
                        const backdrop = document.getElementById('backdrop');
                        
                        if (loginframe && backdrop) {
                            console.log("Showing login frame");
                            loginframe.style.display = 'block';
                            backdrop.style.display = 'block';
                            document.body.style.pointerEvents = 'none';
                            loginframe.style.pointerEvents = 'auto';
                            backdrop.style.pointerEvents = 'auto';
                        } else {
                            console.error("Login frame elements not found");
                        }
                    });
                }
                
                // Setup close login button
                const closeLoginBtn = document.getElementById('closeLogin');
                if (closeLoginBtn) {
                    closeLoginBtn.addEventListener('click', function() {
                        const loginframe = document.getElementById('loginframe');
                        const backdrop = document.getElementById('backdrop');
                        
                        if (loginframe && backdrop) {
                            loginframe.style.display = 'none';
                            backdrop.style.display = 'none';
                            document.body.style.pointerEvents = 'auto';
                        }
                    });
                }
                
                // Setup signin button
                const signinBtn = document.querySelector('.signin-button');
                if (signinBtn) {
                    signinBtn.addEventListener('click', function() {
                        const loginFrame = document.getElementById('loginframe');
                        const signinFrame = document.getElementById('signinframe');
                        
                        if (loginFrame && signinFrame) {
                            loginFrame.style.display = 'none';
                            signinFrame.style.display = 'block';
                        }
                    });
                }
                
                // Setup register button
                const registerBtn = document.getElementById('register');
                if (registerBtn) {
                    registerBtn.addEventListener('click', function() {
                        const loginFrame = document.getElementById('loginframe');
                        const registerFrame = document.getElementById('registerframe');
                        
                        if (loginFrame && registerFrame) {
                            loginFrame.style.display = 'none';
                            registerFrame.style.display = 'block';
                        }
                    });
                }
                
                // Setup back to options button
                const backToOptionsBtn = document.getElementById('backToOptions');
                if (backToOptionsBtn) {
                    backToOptionsBtn.addEventListener('click', function() {
                        const signinFrame = document.getElementById('signinframe');
                        const loginFrame = document.getElementById('loginframe');
                        
                        if (signinFrame && loginFrame) {
                            signinFrame.style.display = 'none';
                            loginFrame.style.display = 'block';
                        }
                    });
                }
                
                // Setup back to login button
                const backToLoginBtn = document.getElementById('backToLogin');
                if (backToLoginBtn) {
                    backToLoginBtn.addEventListener('click', function() {
                        const registerFrame = document.getElementById('registerframe');
                        const loginFrame = document.getElementById('loginframe');
                        
                        if (registerFrame && loginFrame) {
                            registerFrame.style.display = 'none';
                            loginFrame.style.display = 'block';
                        }
                    });
                }
                
                // Setup close register button
                const closeRegisterBtn = document.getElementById('closeRegister');
                if (closeRegisterBtn) {
                    closeRegisterBtn.addEventListener('click', function() {
                        const registerFrame = document.getElementById('registerframe');
                        const backdrop = document.getElementById('backdrop');
                        
                        if (registerFrame && backdrop) {
                            registerFrame.style.display = 'none';
                            backdrop.style.display = 'none';
                            document.body.style.pointerEvents = 'auto';
                        }
                    });
                }
                
                // Setup close signin button
                const closeSigninBtn = document.getElementById('closeSignin');
                if (closeSigninBtn) {
                    closeSigninBtn.addEventListener('click', function() {
                        const signinFrame = document.getElementById('signinframe');
                        const backdrop = document.getElementById('backdrop');
                        
                        if (signinFrame && backdrop) {
                            signinFrame.style.display = 'none';
                            backdrop.style.display = 'none';
                            document.body.style.pointerEvents = 'auto';
                        }
                    });
                }
                
                // User dropdown toggle functionality
                const dropdownToggle = document.getElementById('userDropdownToggle');
                const dropdownMenu = document.getElementById('userDropdownMenu');
                
                if (dropdownToggle && dropdownMenu) {
                    console.log("Found dropdown elements - attaching click handlers");
                    
                    // Create fresh event listener
                    dropdownToggle.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        console.log("Toggle dropdown clicked");
                        dropdownMenu.classList.toggle('show');
                    });
                    
                    // Close the dropdown when clicking outside
                    window.addEventListener('click', function(event) {
                        if (!event.target.matches('#userDropdownToggle') && 
                            !event.target.matches('.profile-pic-small')) {
                            if (dropdownMenu.classList.contains('show')) {
                                dropdownMenu.classList.remove('show');
                            }
                        }
                    });
                }
                
                // Handle View Profile button click
                const viewProfileBtn = document.getElementById('viewProfileBtn');
                if (viewProfileBtn) {
                    viewProfileBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        
                        // Get user data from localStorage
                        const userData = localStorage.getItem('currentUser');
                        if (!userData) {
                            alert('Session data not found. Please log in again.');
                            return;
                        }
                        
                        try {
                            const user = JSON.parse(userData);
                            if (user && user.userId) {
                                window.location.href = `/profile/${user.userId}`;
                            } else {
                                alert('Invalid user data. Please log in again.');
                            }
                        } catch (error) {
                            console.error('Error processing user data:', error);
                            alert('Error accessing profile. Please log in again.');
                        }
                    });
                }
                
                // Handle logout button click
                const logoutBtn = document.getElementById('logoutBtn');
                if (logoutBtn) {
                    logoutBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        
                        // Send a logout request to the server to clear the session
                        fetch('/auth/logout', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        })
                        .then(response => {
                            // Clear local storage AFTER successful server-side logout
                            localStorage.removeItem('currentUser');
                            
                            // Simply reload the page - let the server handle rendering the correct state
                            window.location.reload();
                        })
                        .catch(error => {
                            console.error('Logout error:', error);
                            // Still clear localStorage even if server request fails
                            localStorage.removeItem('currentUser');
                            window.location.reload();
                        });
                    });
                }
                
                // Add session verification on page load
                verifyUserSession();
                
                // Fix profile links in reviews
                const profileLinks = document.querySelectorAll('.scroll-obj h2 a');
                profileLinks.forEach(link => {
                    link.addEventListener('click', function(e) {
                        const href = this.getAttribute('href');
                        // Check if the link ends with just "/profile/" or contains "undefined"
                        if (href === '/profile/' || href.includes('undefined')) {
                            e.preventDefault();
                            alert('User profile not available');
                        }
                    });
                });
                
                // Fix profile images
                const profileImages = document.querySelectorAll('.profile-pic');
                profileImages.forEach(img => {
                    img.onerror = function() {
                        this.src = '../Views/images/profilePictures/default-profile.png';
                    };
                });

                // Setup heart button event
                const heartBtn = document.getElementById('heartBtn');
                if (heartBtn) {
                    heartBtn.addEventListener('click', toggleHeart);
                }
                
                // Setup make review button event
                const makeReviewBtn = document.getElementById('makeReviewBtn');
                if (makeReviewBtn) {
                    makeReviewBtn.addEventListener('click', toggleReviewModal);
                }
                
                // Setup cancel review button event
                const cancelReviewBtn = document.getElementById('cancelReview');
                if (cancelReviewBtn) {
                    cancelReviewBtn.addEventListener('click', toggleReviewModal);
                }
                
                // Setup close review modal button event
                const closeReviewModalBtn = document.getElementById('closeReviewModal');
                if (closeReviewModalBtn) {
                    closeReviewModalBtn.addEventListener('click', toggleReviewModal);
                }
                
                // Setup cancel edit review button event
                const cancelEditReviewBtn = document.getElementById('cancelEditReview');
                if (cancelEditReviewBtn) {
                    cancelEditReviewBtn.addEventListener('click', toggleEditReviewModal);
                }
                
                // Setup close edit review modal button event
                const closeEditReviewModalBtn = document.getElementById('closeEditReviewModal');
                if (closeEditReviewModalBtn) {
                    closeEditReviewModalBtn.addEventListener('click', toggleEditReviewModal);
                }
                
                // Setup edit profile frame handlers
                const closeEditProfileBtn = document.getElementById('closeEditProfile');
                if (closeEditProfileBtn) {
                    closeEditProfileBtn.addEventListener('click', closeEditProfile);
                }
                
                const cancelEditProfileBtn = document.getElementById('cancelEditProfile');
                if (cancelEditProfileBtn) {
                    cancelEditProfileBtn.addEventListener('click', closeEditProfile);
                }
                
                // Setup restaurant edit/delete handlers
                const editRestoBtn = document.getElementById('editRestoBtn');
                if (editRestoBtn) {
                    editRestoBtn.addEventListener('click', togglePopupCreateResto);
                }
                
                const deleteRestoBtn = document.getElementById('deleteRestoBtn');
                if (deleteRestoBtn) {
                    deleteRestoBtn.addEventListener('click', toggleDeleteConfirm);
                }
                
                const cancelCreateRestoBtn = document.getElementById('cancelCreateResto');
                if (cancelCreateRestoBtn) {
                    cancelCreateRestoBtn.addEventListener('click', togglePopupCreateResto);
                }
                
                const closeCreateRestoBtn = document.getElementById('closeCreateResto');
                if (closeCreateRestoBtn) {
                    closeCreateRestoBtn.addEventListener('click', togglePopupCreateResto);
                }
                
                const cancelDeleteRestoBtn = document.getElementById('cancelDeleteResto');
                if (cancelDeleteRestoBtn) {
                    cancelDeleteRestoBtn.addEventListener('click', toggleDeleteConfirm);
                }
                
                const closeDeleteConfirmBtn = document.getElementById('closeDeleteConfirm');
                if (closeDeleteConfirmBtn) {
                    closeDeleteConfirmBtn.addEventListener('click', toggleDeleteConfirm);
                }
                
                const confirmDeleteRestoBtn = document.getElementById('confirmDeleteResto');
                if (confirmDeleteRestoBtn) {
                    confirmDeleteRestoBtn.addEventListener('click', deleteRestaurant);
                }
                
                // Check if current restaurant is already in user's saved list
                checkIfRestaurantIsLiked();
                
                // Setup edit review buttons
                const editReviewBtns = document.querySelectorAll('.edit-review-btn');
                editReviewBtns.forEach(btn => {
                    btn.addEventListener('click', function() {
                        const reviewId = this.getAttribute('data-id');
                        openEditReview(reviewId);
                    });
                });
                
                // Setup delete review buttons
                const deleteReviewBtns = document.querySelectorAll('.delete-review');
                deleteReviewBtns.forEach(btn => {
                    btn.addEventListener('click', function() {
                        const reviewId = this.getAttribute('data-id');
                        openDeleteReviewConfirm(reviewId);
                    });
                });
            });
            
            function toggleHeart() {
                const heartIcon = document.getElementById("heartIcon");
                const isLiking = !heartIcon.classList.contains("liked");
                
                // Get current user data
                const userData = localStorage.getItem('currentUser');
                if (!userData) {
                    alert('Please login to save restaurants');
                    return;
                }
                
                try {
                    const user = JSON.parse(userData);
                    if (!user || !user.userId) {
                        alert('Please login to save restaurants');
                        return;
                    }
                    
                    const userId = user.userId;
                    const endpoint = isLiking ? '/api/restaurants/like' : '/api/restaurants/unlike';
                    
                    // Send API request to like/unlike restaurant
                    fetch(endpoint, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            userId: userId,
                            restoId: restaurantId
                        })
                    })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Server error');
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            // Toggle heart appearance
                            heartIcon.classList.toggle("liked");
                            heartIcon.style.color = isLiking ? "red" : "gray";
                            console.log(isLiking ? 'Restaurant saved' : 'Restaurant unsaved');
                        } else {
                            console.error('Failed to update saved status:', data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error updating restaurant saved status:', error);
                        alert('Failed to update restaurant saved status: ' + error.message);
                    });
                } catch (e) {
                    console.error('Error parsing user data:', e);
                    alert('Please login to save restaurants');
                }
            }
            
            function toggleReviewModal() {
                const backdrop = document.getElementById('backdrop');
                const reviewModal = document.getElementById('reviewModal');
                
                if (reviewModal.style.display === 'block') {
                    reviewModal.style.display = 'none';
                    backdrop.style.display = 'none';
                } else {
                    reviewModal.style.display = 'block';
                    backdrop.style.display = 'block';
                }
            }
            
            function toggleEditReviewModal() {
                const backdrop = document.getElementById('backdrop');
                const editReviewModal = document.getElementById('editReviewModal');
                
                if (editReviewModal.style.display === 'block') {
                    editReviewModal.style.display = 'none';
                    backdrop.style.display = 'none';
                } else {
                    editReviewModal.style.display = 'block';
                    backdrop.style.display = 'block';
                }
            }
            
            function togglePopupCreateResto() {
                const popup = document.getElementById('createRestoFrame');
                const backdrop = document.getElementById('backdrop');
                
                if (popup.style.display === 'block') {
                    popup.style.display = 'none';
                    backdrop.style.display = 'none';
                } else {
                    popup.style.display = 'block';
                    backdrop.style.display = 'block';
                    
                    // Call populateEditForm if it exists
                    if (typeof populateEditForm === 'function') {
                        populateEditForm();
                    }
                }
            }
            
            function toggleDeleteConfirm() {
                const popup = document.getElementById('deleteConfirmPopup');
                const backdrop = document.getElementById('backdrop');
                
                if (popup.style.display === 'block') {
                    popup.style.display = 'none';
                    backdrop.style.display = 'none';
                } else {
                    popup.style.display = 'block';
                    backdrop.style.display = 'block';
                }
            }
            
            function closeEditProfile() {
                const editProfileFrame = document.getElementById('editProfileFrame');
                const backdrop = document.getElementById('backdrop');
                
                editProfileFrame.style.display = 'none';
                backdrop.style.display = 'none';
            }
            
            function openEditReview(reviewId) {
                // Set the review ID in the form
                document.getElementById('edit-review-id').value = reviewId;
                
                // Call the toggle function to show the modal
                toggleEditReviewModal();
                
                // You could also fetch the review data from the server to pre-populate the form
                // For now, we'll assume this functionality exists elsewhere
            }
            
            function openDeleteReviewConfirm(reviewId) {
                // Store the review ID for later use
                document.getElementById('confirmDeleteReview').setAttribute('data-id', reviewId);
                
                // Show the delete confirmation dialog
                const deleteReviewConfirm = document.getElementById('deleteReviewConfirmPopup');
                const backdrop = document.getElementById('backdrop');
                
                deleteReviewConfirm.style.display = 'block';
                backdrop.style.display = 'block';
            }
            
            function checkIfRestaurantIsLiked() {
                const userData = localStorage.getItem('currentUser');
                if (!userData) {
                    return;
                }
                
                try {
                    const user = JSON.parse(userData);
                    if (!user || !user.userId) {
                        return;
                    }
                    
                    const userId = user.userId;
                    const restoId = "{{restaurant.id}}";
                    
                    // Fetch user's saved restaurants
                    fetch(`/api/likes/saved-restaurants/${userId}`)
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Failed to fetch saved restaurants');
                            }
                            return response.json();
                        })
                        .then(restaurants => {
                            // Check if current restaurant is in the list
                            const isLiked = restaurants.some(resto => resto.resto_id == restoId);
                            const heartIcon = document.getElementById("heartIcon");
                            
                            // Update heart icon if restaurant is liked
                            if (isLiked && heartIcon) {
                                heartIcon.classList.add("liked");
                                heartIcon.style.color = "red";
                            }
                        })
                        .catch(error => {
                            console.error('Error checking if restaurant is liked:', error);
                        });
                } catch (e) {
                    console.error('Error parsing user data:', e);
                }
            }

            // Add this function to verify user session is valid
            function verifyUserSession() {
                const userData = localStorage.getItem('currentUser');
                if (!userData) {
                    return; // No stored user data, nothing to verify
                }
                
                try {
                    const user = JSON.parse(userData);
                    if (!user || !user.userId) {
                        localStorage.removeItem('currentUser');
                        return;
                    }
                    
                    // Call an endpoint to verify the session
                    fetch('/api/auth/verify-session')
                        .then(response => response.json())
                        .then(data => {
                            if (!data.authenticated || data.userId != user.userId) {
                                console.log('Session invalid or expired, clearing local data');
                                localStorage.removeItem('currentUser');
                                // Only reload if we appear to be logged in but session is invalid
                                const userDropdown = document.querySelector('.user-dropdown');
                                if (userDropdown) {
                                    window.location.reload();
                                }
                            }
                        })
                        .catch(error => {
                            console.error('Error verifying session:', error);
                        });
                } catch (e) {
                    console.error('Error parsing user data:', e);
                    localStorage.removeItem('currentUser');
                }
            }
        </script>
        
        <script src='/Controllers/directoryScript.js'></script>
        <script src='/Controllers/Restaurants/updateResto.js'></script>
        <script src='/Controllers/Restaurants/deleteResto.js'></script>
        <script src='/Controllers/Reviews/addReview.js'></script>
        <script src='/Controllers/Reviews/editReview.js'></script>
        <script src='/Controllers/Reviews/deleteReview.js'></script>
